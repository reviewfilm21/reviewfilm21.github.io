        // ============================================
        // DETAIL PAGE FUNCTIONS (DITINGKATKAN)
        // ============================================
        async function openDetailPage(item) {
            state.currentMedia = item;
            state.currentServer = 1;
            state.currentSeason = 1;
            state.currentEpisode = 1;
            state.trailerKey = '';

            document.title = `Nonton ${item.title} (${item.year}) Subtitle Indonesia - ReviewFilm21`;

            document.getElementById('detail-title').textContent = item.title;
            document.getElementById('detail-type-badge').textContent = item.type === 'tv' ? 'TV SERIES' : 'MOVIE';
            document.getElementById('detail-rating').textContent = `★ ${item.rating}`;
            document.getElementById('detail-year').textContent = item.year;
            document.getElementById('detail-genres').textContent = item.genre || 'Pustaka Film';
            document.getElementById('detail-overview').textContent = item.overview || 'Tidak ada deskripsi tersedia.';
            document.getElementById('detail-poster').src = item.poster_path;

            updateDetailFavoriteButton();

            // **PERUBAHAN: Episode container untuk series dari pustaka**
            const epContainer = document.getElementById('episodes-container');
            const epGrid = document.getElementById('episodes-grid');
            
            // Cek apakah ini series dan ada data episode lain di libraryData
            const isSeries = item.type === 'tv' || 
                            (item.title && (item.title.toLowerCase().includes('season') || 
                                           item.title.toLowerCase().includes('episode')));
            
            if (isSeries) {
                // Cari semua episode untuk series ini dari libraryData
                const baseTitle = item.title
                    .replace(/season\s*\d+/i, '')
                    .replace(/episode\s*\d+/i, '')
                    .replace(/[Ee]p(?:isode)?\s*[\d]+/i, '')
                    .trim()
                    .replace(/[📺🎬]/g, '').trim();
                
                const allEpisodes = state.libraryData.filter(data => {
                    const dataTitle = data.Judul || '';
                    return dataTitle.toLowerCase().includes(baseTitle.toLowerCase()) && 
                           dataTitle !== item.title;
                });
                
                // Urutkan berdasarkan episode
                allEpisodes.sort((a, b) => {
                    const aMatch = a.Judul.match(/[Ee]p(?:isode)?\s*[\d]+/i) || a.Judul.match(/[\d]+\s*[\)\]]?$/);
                    const bMatch = b.Judul.match(/[Ee]p(?:isode)?\s*[\d]+/i) || b.Judul.match(/[\d]+\s*[\)\]]?$/);
                    let aNum = 999, bNum = 999;
                    if (aMatch) { const n = aMatch[0].match(/\d+/); if (n) aNum = parseInt(n[0]); }
                    if (bMatch) { const n = bMatch[0].match(/\d+/); if (n) bNum = parseInt(n[0]); }
                    return aNum - bNum;
                });
                
                if (allEpisodes.length > 0) {
                    epContainer.classList.remove('hidden');
                    let epHTML = `<button onclick="switchLibraryEpisode('${item.link}')" id="ep-btn-current" class="focusable px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-lg text-[10px] sm:text-xs font-bold bg-brand-500 text-white">Episode 1 (Saat Ini)</button>`;
                    
                    allEpisodes.forEach((ep, idx) => {
                        const epNum = idx + 2; // Episode 2, 3, dst
                        epHTML += `<button onclick="playLibraryItem('${ep.Link}', '${ep.Judul}', '${ep.Poster}', '${ep.Rating}', '${ep.Tahun}', '${ep.Deskripsi || ''}', '${ep.Aktor || ''}', 'tv')" 
                                    id="ep-btn-${epNum}" 
                                    class="focusable px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-lg text-[10px] sm:text-xs font-medium bg-zinc-800 text-zinc-300 hover:bg-zinc-700 transition-all">
                                    Episode ${epNum}
                                  </button>`;
                    });
                    
                    epGrid.innerHTML = epHTML;
                } else {
                    // Jika tidak ada episode lain, tetap tampilkan container kosong
                    epContainer.classList.remove('hidden');
                    epGrid.innerHTML = `<span class="text-xs text-zinc-400">Episode lain belum tersedia</span>`;
                }
            } else {
                epContainer.classList.add('hidden');
            }

            document.querySelectorAll('#main-content > *:not(#detail-section)').forEach(s => s.classList.add('hidden'));
            document.getElementById('detail-section').classList.remove('hidden');

            // **PERUBAHAN: Gunakan link dari item jika tersedia**
            if (item.link && item.isLibraryItem) {
                // Untuk item dari pustaka, gunakan link langsung
                const iframe = document.getElementById('video-iframe');
                if (iframe) {
                    // Jika link adalah YouTube atau Dailymotion, embed langsung
                    let embedUrl = item.link;
                    if (embedUrl.includes('youtube.com/watch?v=')) {
                        const videoId = embedUrl.match(/v=([^&]+)/);
                        if (videoId) embedUrl = `https://www.youtube.com/embed/${videoId[1]}`;
                    } else if (embedUrl.includes('youtu.be/')) {
                        const videoId = embedUrl.match(/youtu\.be\/([^?]+)/);
                        if (videoId) embedUrl = `https://www.youtube.com/embed/${videoId[1]}`;
                    } else if (embedUrl.includes('dailymotion.com')) {
                        // Dailymotion sudah embed
                    } else if (embedUrl.includes('mxdrop.sx') || embedUrl.includes('vinovo.to')) {
                        // Untuk mxdrop/vinovo, gunakan iframe dengan src langsung
                        // Tapi biasanya mereka butuh embed URL
                        if (!embedUrl.includes('embed')) {
                            embedUrl = embedUrl.replace('/e/', '/embed/');
                        }
                    }
                    iframe.src = embedUrl;
                }
            } else {
                // Untuk item dari TMDB, gunakan server
                switchServer(1);
                updateIframeSource();
            }

            // Fetch trailer jika item dari TMDB
            if (!item.isLibraryItem) {
                try {
                    const res = await fetch(`https://api.themoviedb.org/3/${item.type}/${item.id}/videos?language=id-ID&api_key=${DEFAULT_API_KEY}`);
                    if (res.ok) {
                        const data = await res.json();
                        let officialTrailer = data.results?.find(v => v.type === 'Trailer' && v.site === 'YouTube') || data.results?.find(v => v.site === 'YouTube');
                        if (officialTrailer) state.trailerKey = officialTrailer.key;
                    }
                } catch(e) {}
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
            setTimeout(updateTvFocusables, 200);
        }

