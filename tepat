        // ============================================
        // FUNGSI LOAD DATA DARI GOOGLE SHEETS
        // ============================================
        async function loadLibraryFromGoogleSheets() {
            try {
                showToast('Memuat data pustaka dari Google Sheets...', '⏳');
                
                const response = await fetch(GOOGLE_SHEETS_CSV_URL);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const csvText = await response.text();
                const parsedData = parseCSV(csvText);
                
                if (parsedData.length === 0) {
                    throw new Error('Data CSV kosong atau tidak valid');
                }
                
                state.libraryData = parsedData;
                state.isLibraryLoaded = true;
                
