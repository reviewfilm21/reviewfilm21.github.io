            let collectionContainer = document.getElementById('collection-container');
            if (!collectionContainer) { collectionContainer = document.createElement('section'); collectionContainer.id = 'collection-container'; collectionContainer.className = 'space-y-3 sm:space-y-4'; document.getElementById('main-content').appendChild(collectionContainer); }
            collectionContainer.classList.remove('hidden');
            collectionContainer.innerHTML = `<div class="flex items-center justify-between border-b border-zinc-800 pb-2 sm:pb-3"><h2 class="text-base sm:text-xl font-bold text-white">📚 ${categoryName} <span class="text-xs text-zinc-400">(${items.length})</span></h2><button onclick="closeCollection()" class="focusable text-zinc-400 hover:text-white p-1 rounded-lg bg-zinc-900 border border-zinc-800 text-xs">✕ Tutup</button></div><div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 sm:gap-4">${items.map(item => createLibraryCardHTML(item)).join('')}</div>`;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function closeCollection() { const cc = document.getElementById('collection-container'); if (cc) cc.classList.add('hidden'); switchTab('home'); }

        function createLibraryCardHTML(item) {
            const title = item.Judul || 'Tanpa Judul';
            const poster = item.Poster || 'https://placehold.co/400x600/18181b/ff5c00?text=No+Poster';
            const rating = item.Rating || '8.0';
            const year = item.Tahun || '2026';
            const link = item.Link || '#';
            return `
                <article class="focusable poster-card bg-zinc-900 rounded-lg sm:rounded-xl overflow-hidden border border-zinc-800/80 group cursor-pointer" tabindex="0" onclick="playLibraryItem('${link.replace(/'/g, "\\'")}', '${title.replace(/'/g, "\\'")}', '${poster}', '${rating}', '${year}', '', '', 'movie')">
                    <div class="relative aspect-[2/3] overflow-hidden bg-zinc-950">
                        <img src="${poster}" alt="${title}" loading="lazy" onerror="this.src='https://placehold.co/400x600/18181b/ff5c00?text=No+Poster'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                        <div class="absolute top-1 left-1 bg-black/70 text-amber-400 font-extrabold text-[8px] px-1.5 py-0.5 rounded">★ ${rating}</div>
                        <div class="absolute inset-0 bg-brand-600/40 play-overlay flex flex-col items-center justify-center">
                            <div class="w-8 h-8 sm:w-12 sm:h-12 rounded-full bg-brand-500 text-white flex items-center justify-center mb-1"><svg class="w-4 h-4 sm:w-6 sm:h-6 fill-current translate-x-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
                            <span class="text-white text-[8px] sm:text-xs font-black">TONTON</span>
                        </div>
                    </div>
                    <div class="p-2 sm:p-3">
                        <h3 class="text-[10px] sm:text-sm font-bold text-white truncate">${title}</h3>
                        <div class="flex justify-between text-[8px] text-zinc-400"><span>${year}</span><span>HD</span></div>
                    </div>
                </article>
            `;
        }

        function playLibraryItem(link, title, poster, rating, year, desc, actors, type) {
            if (!link || link === '#') { showToast('Link tidak tersedia', '⚠️'); return; }
            const mediaItem = { id: Math.floor(Math.random() * 1000000), title, type: 'movie', rating, year, genre: 'Pustaka', overview: desc || '', poster_path: poster, backdrop_path: poster, link, isLibraryItem: true };
            const key = getMediaKey(mediaItem.type, mediaItem.id);
            mediaCache.set(key, mediaItem);
            openDetailPage(mediaItem);
            window.location.hash = `#/movie/${mediaItem.id}/${slugify(title)}`;
        }

        // Route Handler (HASH-BASED)
        function handleRoute() {
            const hash = window.location.hash || '#/';
            const path = hash.substring(1);
            if (path === '/' || path === '') { switchTab('home'); return; }
            if (path === '/movies') { switchTab('movies'); return; }
            if (path === '/tv') { switchTab('tv'); return; }
            if (path === '/watchlist') { switchTab('watchlist'); return; }
            switchTab('home');
        }

        // Smart TV
        function initSmartTvControls() {
            window.addEventListener('keydown', (e) => {
                const key = e.key;
                if (key === 'ArrowLeft') { e.preventDefault(); navigateTv('left'); }
                else if (key === 'ArrowUp') { e.preventDefault(); navigateTv('up'); }
                else if (key === 'ArrowRight') { e.preventDefault(); navigateTv('right'); }
                else if (key === 'ArrowDown') { e.preventDefault(); navigateTv('down'); }
                else if (key === 'Enter') { if (tvIndex >= 0 && tvFocusables[tvIndex]) tvFocusables[tvIndex].click(); }
                else if (key === 'Escape' || key === 'Backspace') {
                    const detail = document.getElementById('detail-section');
                    if (detail && !detail.classList.contains('hidden')) { closeDetailPage(); e.preventDefault(); }
                }
            });
        }

        function navigateTv(direction) {
            updateTvFocusables();
            if (tvFocusables.length === 0) return;
            if (tvIndex < 0) tvIndex = 0;
            else {
                tvFocusables[tvIndex]?.classList.remove('tv-focused');
                if (direction === 'right' || direction === 'down') tvIndex = (tvIndex + 1) % tvFocusables.length;
                else if (direction === 'left' || direction === 'up') tvIndex = (tvIndex - 1 + tvFocusables.length) % tvFocusables.length;
            }
            const current = tvFocusables[tvIndex];
            if (current) { current.classList.add('tv-focused'); current.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
        }

        // Init
        window.addEventListener('hashchange', handleRoute);
        window.onload = function () {
            updateWatchlistBadge();
            setupHeroCarousel();
            renderAllSections();
            initSmartTvControls();
            handleRoute();
            loadLibraryFromGoogleSheets();
        };
    </script>
    <script src="https://thrillingdeepcutlery.com/40/b6/14/40b61407ad664f04dd80c6346cb46fac.js"></script>
</body>
