            const mediaItem = {
                id: Math.floor(Math.random() * 1000000),
                title: title,
                type: type || (title.toLowerCase().includes('season') || title.toLowerCase().includes('episode') ? 'tv' : 'movie'),
                rating: rating || '8.0',
                year: year || '2026',
                genre: 'Pustaka Film',
                overview: description || 'Tidak ada deskripsi tersedia.',
                poster_path: poster || 'https://placehold.co/400x600/18181b/ff5c00?text=No+Poster',
                backdrop_path: poster || 'https://placehold.co/1200x600/18181b/ff5c00?text=No+Cover',
                link: link,
                actors: actors || '',
                isLibraryItem: true
            };

            // Simpan ke cache agar bisa diakses
            const key = getMediaKey(mediaItem.type, mediaItem.id);
            mediaCache.set(key, mediaItem);

            // Buka detail page dengan item ini
            openDetailPage(mediaItem);

            // Update URL
            const slug = slugify(mediaItem.title);
            const path = `/${mediaItem.type}/${mediaItem.id}/${slug}`;
            history.pushState({ mediaId: mediaItem.id, type: mediaItem.type }, '', path);
        }

