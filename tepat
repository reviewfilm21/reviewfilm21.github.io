        async function executeSearch(query) {
            state.searchQuery = query;
            document.getElementById('search-query-text').textContent = `"${query}"`;

            let tmdbMatches = [];
            try {
                const res = await fetch(`https://api.themoviedb.org/3/search/multi?language=id-ID&query=${encodeURIComponent(query)}&api_key=${DEFAULT_API_KEY}`);
                if (res.ok) {
                    const data = await res.json();
                    if (data?.results) {
                        tmdbMatches = data.results
                            .filter(x => x.media_type === 'movie' || x.media_type === 'tv')
                            .map(item => {
                                const title = item.title || item.name || 'Tanpa Judul';
                                const releaseDate = item.release_date || item.first_air_date || '2026';
                                const year = releaseDate ? (releaseDate.split('-')[0] || '2026') : '2026';
                                return {
                                    id: item.id,
                                    title: title,
                                    type: item.media_type,
                                    rating: item.vote_average ? item.vote_average.toFixed(1) : '8.0',
                                    year: year,
                                    genre: 'Bioskop',
                                    overview: item.overview || 'Tidak ada deskripsi tersedia.',
                                    poster_path: item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : 'https://placehold.co/400x600/18181b/ff5c00?text=No+Poster',
                                    backdrop_path: item.backdrop_path ? `https://image.tmdb.org/t/p/w1280${item.backdrop_path}` : 'https://placehold.co/1200x600/18181b/ff5c00?text=No+Cover'
                                };
                            })
                            .filter(Boolean);
                    }
                }
            } catch(e) {}

            if (tmdbMatches.length === 0) {
                const qLower = query.toLowerCase();
                tmdbMatches = [...FALLBACK_MOVIES, ...FALLBACK_SERIES].filter(item => 
                    item.title.toLowerCase().includes(qLower)
                );
            }

            const searchGrid = document.getElementById('search-grid');
            const searchCount = document.getElementById('search-count');
            searchCount.textContent = `${tmdbMatches.length} Film Ditemukan`;

            if (tmdbMatches.length === 0) {
                searchGrid.innerHTML = `<div class="col-span-full py-8 text-center text-zinc-500 text-sm">Tidak ditemukan hasil untuk "${query}".</div>`;
            } else {
                searchGrid.innerHTML = tmdbMatches.map(item => createCardHTML(item)).join('');
            }
            document.getElementById('search-section').classList.remove('hidden');
            setTimeout(updateTvFocusables, 200);
        }

