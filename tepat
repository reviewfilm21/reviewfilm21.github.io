        // **FUNGSI BARU: Filter hanya Episode 1 dari setiap series**
        function filterSeriesOnlyEpisode1(items) {
            const grouped = {};
            const result = [];
            
            items.forEach(item => {
                const title = item.Judul || '';
                // Deteksi apakah ini series (ada kata Season/Episode)
                const isSeries = title.toLowerCase().includes('season') || 
                                title.toLowerCase().includes('episode') ||
                                title.toLowerCase().includes('series');
                
                if (!isSeries) {
                    // Film biasa langsung dimasukkan
                    result.push(item);
                    return;
                }
                
                // Ekstrak judul dasar (tanpa Season/Episode)
                let baseTitle = title;
                // Hapus pola "Season X Episode Y" atau "Episode Y"
                baseTitle = baseTitle.replace(/season\s*\d+/i, '').replace(/episode\s*\d+/i, '').trim();
                baseTitle = baseTitle.replace(/[📺🎬]/g, '').trim();
                // Hapus keterangan episode di akhir
                baseTitle = baseTitle.replace(/-\s*(season|episode|eps|s)\s*[\d]+/i, '').trim();
                baseTitle = baseTitle.replace(/[\(\[]?\s*(season|episode|eps|s)\s*[\d]+\s*[\)\]]?/i, '').trim();
                // Hapus angka episode di akhir
                baseTitle = baseTitle.replace(/\s*[\(\[\{]\s*[Ee]p(?:isode)?\s*[\d]+\s*[\)\]\}]/, '').trim();
                baseTitle = baseTitle.replace(/\s*[Ee]p(?:isode)?\s*[\d]+\s*$/, '').trim();
                
                // Jika judul kosong setelah dibersihkan, gunakan judul asli
                if (!baseTitle) baseTitle = title;
                
                // Ambil episode nomor
                const epMatch = title.match(/[Ee]p(?:isode)?\s*[\d]+/i) || title.match(/[\d]+\s*[\)\]]?$/);
                let epNumber = 999;
                if (epMatch) {
                    const numMatch = epMatch[0].match(/\d+/);
                    if (numMatch) epNumber = parseInt(numMatch[0]);
                }
                
                const key = baseTitle.toLowerCase().trim();
                if (!grouped[key] || epNumber < grouped[key].epNumber) {
                    grouped[key] = { item, epNumber };
                }
            });
            
            // Ambil hanya item dengan episode terkecil (Episode 1)
            Object.values(grouped).forEach(({ item }) => {
                result.push(item);
            });
            
            return result;
        }

