        // ============================================
        // FETCH TMDB DATA
        // ============================================
        async function fetchTMDBCatalogs() {
            try {
                const genreEl = document.getElementById('genre-filter');
                const yearEl = document.getElementById('year-filter');
                const genreId = genreEl ? genreEl.value : '';
                const yearVal = yearEl ? yearEl.value : '';

                let endpointAppend = '';
                if (genreId) endpointAppend += `&with_genres=${genreId}`;
                if (yearVal) endpointAppend += `&primary_release_year=${yearVal}&first_air_date_year=${yearVal}`;

                let fetchedAny = false;

                try {
                    const resTrending = await fetch(`https://api.themoviedb.org/3/trending/all/week?language=id-ID${endpointAppend}&api_key=${DEFAULT_API_KEY}`);
                    if (resTrending.ok) {
                        const data = await resTrending.json();
                        if (data?.results?.length) {
                            state.trendingData = data.results.map(item => {
                                const title = item.title || item.name || 'Tanpa Judul';
                                const releaseDate = item.release_date || item.first_air_date || '2026';
                                const year = releaseDate ? (releaseDate.split('-')[0] || '2026') : '2026';
                                return {
                                    id: item.id,
                                    title: title,
                                    type: item.media_type || (item.title ? 'movie' : 'tv'),
                                    rating: item.vote_average ? item.vote_average.toFixed(1) : '8.0',
                                    year: year,
                                    genre: 'Bioskop',
                                    overview: item.overview || 'Tidak ada deskripsi tersedia.',
                                    poster_path: item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : 'https://placehold.co/400x600/18181b/ff5c00?text=No+Poster',
                                    backdrop_path: item.backdrop_path ? `https://image.tmdb.org/t/p/w1280${item.backdrop_path}` : 'https://placehold.co/1200x600/18181b/ff5c00?text=No+Cover'
                                };
                            }).filter(Boolean);
                            state.heroItems = state.trendingData.slice(0, 5);
                            fetchedAny = true;
                        }
                    }
                } catch(e) {}

                try {
                    const resMovies = await fetch(`https://api.themoviedb.org/3/discover/movie?language=id-ID&sort_by=popularity.desc${endpointAppend}&api_key=${DEFAULT_API_KEY}`);
                    if (resMovies.ok) {
                        const data = await resMovies.json();
                        if (data?.results?.length) {
                            state.moviesData = data.results.map(item => {
                                const title = item.title || 'Tanpa Judul';
                                const year = item.release_date ? (item.release_date.split('-')[0] || '2026') : '2026';
                                return {
                                    id: item.id,
                                    title: title,
                                    type: 'movie',
                                    rating: item.vote_average ? item.vote_average.toFixed(1) : '8.0',
                                    year: year,
                                    genre: 'Bioskop',
                                    overview: item.overview || 'Tidak ada deskripsi tersedia.',
                                    poster_path: item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : 'https://placehold.co/400x600/18181b/ff5c00?text=No+Poster',
                                    backdrop_path: item.backdrop_path ? `https://image.tmdb.org/t/p/w1280${item.backdrop_path}` : 'https://placehold.co/1200x600/18181b/ff5c00?text=No+Cover'
                                };
                            }).filter(Boolean);
                            fetchedAny = true;
                        }
                    }
                } catch(e) {}

                try {
                    const resTV = await fetch(`https://api.themoviedb.org/3/discover/tv?language=id-ID&sort_by=popularity.desc${endpointAppend}&api_key=${DEFAULT_API_KEY}`);
                    if (resTV.ok) {
                        const data = await resTV.json();
                        if (data?.results?.length) {
                            state.seriesData = data.results.map(item => {
                                const title = item.name || 'Tanpa Judul';
                                const year = item.first_air_date ? (item.first_air_date.split('-')[0] || '2026') : '2026';
                                return {
                                    id: item.id,
                                    title: title,
                                    type: 'tv',
                                    rating: item.vote_average ? item.vote_average.toFixed(1) : '8.0',
                                    year: year,
                                    genre: 'TV Series',
                                    overview: item.overview || 'Tidak ada deskripsi tersedia.',
                                    poster_path: item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : 'https://placehold.co/400x600/18181b/ff5c00?text=No+Poster',
                                    backdrop_path: item.backdrop_path ? `https://image.tmdb.org/t/p/w1280${item.backdrop_path}` : 'https://placehold.co/1200x600/18181b/ff5c00?text=No+Cover'
                                };
                            }).filter(Boolean);
                            fetchedAny = true;
                        }
                    }
                } catch(e) {}

                try {
                    const resThriller = await fetch(`https://api.themoviedb.org/3/discover/movie?language=id-ID&with_genres=53&sort_by=popularity.desc${endpointAppend}&api_key=${DEFAULT_API_KEY}`);
                    if (resThriller.ok) {
                        const data = await resThriller.json();
                        if (data?.results?.length) {
                            state.thrillerData = data.results.map(item => {
                                const title = item.title || 'Tanpa Judul';
                                const year = item.release_date ? (item.release_date.split('-')[0] || '2026') : '2026';
                                return {
                                    id: item.id,
                                    title: title,
                                    type: 'movie',
                                    rating: item.vote_average ? item.vote_average.toFixed(1) : '8.0',
                                    year: year,
                                    genre: 'Thriller',
                                    overview: item.overview || 'Tidak ada deskripsi tersedia.',
                                    poster_path: item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : 'https://placehold.co/400x600/18181b/ff5c00?text=No+Poster',
                                    backdrop_path: item.backdrop_path ? `https://image.tmdb.org/t/p/w1280${item.backdrop_path}` : 'https://placehold.co/1200x600/18181b/ff5c00?text=No+Cover'
                                };
                            }).filter(Boolean);
                            fetchedAny = true;
                        }
                    }
                } catch(e) {}

                if (fetchedAny) setupHeroCarousel();
                renderAllSections();
            } catch (err) {
                renderAllSections();
            }
        }

        // ============================================
        // ROUTE HANDLER
        // ============================================
        async function handleRoute() {
            const path = window.location.pathname;
            if (path === '/') { switchTab('home'); return; }
            if (path === '/movies') { switchTab('movies'); return; }
            if (path === '/tv') { switchTab('tv'); return; }
            if (path === '/watchlist') { switchTab('watchlist'); return; }

            const movieMatch = path.match(/^\/movie\/(\d+)(?:\/[^/]+)?$/);
            if (movieMatch) { await openMediaById(movieMatch[1], 'movie'); return; }
            const tvMatch = path.match(/^\/tv\/(\d+)(?:\/[^/]+)?$/);
            if (tvMatch) { await openMediaById(tvMatch[1], 'tv'); return; }

            switchTab('home');
        }

        async function openMediaById(id, type) {
            const key = getMediaKey(type, id);
            let item = mediaCache.get(key);
            if (!item) {
                try {
                    const res = await fetch(`https://api.themoviedb.org/3/${type}/${id}?language=id-ID&api_key=${DEFAULT_API_KEY}`);
                    if (res.ok) {
                        const data = await res.json();
                        const title = data.title || data.name || 'Tanpa Judul';
                        const releaseDate = data.release_date || data.first_air_date || '2026';
                        const year = releaseDate ? (releaseDate.split('-')[0] || '2026') : '2026';
                        item = {
                            id: data.id,
                            title: title,
                            type: type,
                            rating: data.vote_average ? data.vote_average.toFixed(1) : '8.0',
                            year: year,
                            genre: 'Bioskop',
                            overview: data.overview || 'Tidak ada deskripsi tersedia.',
                            poster_path: data.poster_path ? `https://image.tmdb.org/t/p/w500${data.poster_path}` : 'https://placehold.co/400x600/18181b/ff5c00?text=No+Poster',
                            backdrop_path: data.backdrop_path ? `https://image.tmdb.org/t/p/w1280${data.backdrop_path}` : 'https://placehold.co/1200x600/18181b/ff5c00?text=No+Cover'
                        };
                        mediaCache.set(key, item);
                    }
                } catch(e) {}
            }
            if (item) {
                const slug = slugify(item.title);
                const expectedPath = `/${type}/${id}/${slug}`;
                if (window.location.pathname !== expectedPath) history.replaceState(null, '', expectedPath);
                openDetailPage(item);
            } else {
                showToast('Konten tidak ditemukan', '⚠️');
                navigateTo('home');
            }
        }

        // ============================================
        // SMART TV CONTROLS
        // ============================================
        function initSmartTvControls() {
            window.addEventListener('keydown', (e) => {
                const key = e.key;
                const keyCode = e.keyCode || e.which;
                if (key === 'ArrowLeft' || keyCode === 37) {
                    e.preventDefault();
                    navigateTv('left');
                } else if (key === 'ArrowUp' || keyCode === 38) {
                    e.preventDefault();
                    navigateTv('up');
                } else if (key === 'ArrowRight' || keyCode === 39) {
                    e.preventDefault();
                    navigateTv('right');
                } else if (key === 'ArrowDown' || keyCode === 40) {
                    e.preventDefault();
                    navigateTv('down');
                } else if (key === 'Enter' || keyCode === 13) {
                    if (tvIndex >= 0 && tvFocusables[tvIndex]) tvFocusables[tvIndex].click();
                } else if (key === 'Escape' || key === 'Backspace' || keyCode === 27 || keyCode === 8 || keyCode === 10009) {
                    const detailSection = document.getElementById('detail-section');
                    const requestModal = document.getElementById('request-modal');
                    const shareModal = document.getElementById('share-modal');
                    const collectionContainer = document.getElementById('collection-container');
                    if (detailSection && !detailSection.classList.contains('hidden')) {
                        closeDetailPage();
                        e.preventDefault();
                    } else if (requestModal && !requestModal.classList.contains('hidden')) {
                        closeRequestModal();
                        e.preventDefault();
                    } else if (shareModal && !shareModal.classList.contains('hidden')) {
                        closeShareModal();
                        e.preventDefault();
                    } else if (collectionContainer && !collectionContainer.classList.contains('hidden')) {
                        closeCollection();
                        e.preventDefault();
                    }
                }
            });
        }

        function navigateTv(direction) {
            updateTvFocusables();
            if (tvFocusables.length === 0) return;
            if (tvIndex < 0) tvIndex = 0;
            else {
                tvFocusables[tvIndex]?.classList.remove('tv-focused');
                if (direction === 'right' || direction === 'down') tvIndex = (tvIndex + 1) % tvFocusables.length;
                else if (direction === 'left' || direction === 'up') tvIndex = (tvIndex - 1 + tvFocusables.length) % tvFocusables.length;
            }
            const current = tvFocusables[tvIndex];
            if (current) {
                current.classList.add('tv-focused');
                current.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
            }
        }

        // ============================================
        // WINDOW LOAD
        // ============================================
        window.addEventListener('popstate', handleRoute);

        window.onload = function () {
            updateWatchlistBadge();
            setupHeroCarousel();
            renderAllSections();
            fetchTMDBCatalogs();
            initSmartTvControls();
            handleRoute();
            setTimeout(updateTvFocusables, 500);

            loadLibraryFromGoogleSheets();
        };
    </script>
