window.onload = async function() {
    console.log('🚀 App starting...');
    updateWatchlistBadge();
    
    // LOAD movies.json PERTAMA KALI
    const loaded = await loadMoviesFromJSON();
    
    if (!loaded) {
        console.log('⚠️ movies.json not found, using fallback data');
        // Gunakan data fallback
        renderAllSections();
    }
    
    // Refresh setiap 5 menit
    setInterval(async () => {
        console.log('🔄 Auto-refresh data...');
        await loadMoviesFromJSON();
    }, 5 * 60 * 1000);
    
    hideLoading();
    console.log('✅ App ready');
};
